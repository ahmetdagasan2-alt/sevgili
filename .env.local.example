# Bu dosyayı .env.local olarak kopyalayıp doldurun. Gerçek değerleri BURAYA yazmayın.

# Auth0 (Regular Web Application)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Supabase (panelde üstteki "Connect" butonu veya Project Settings > Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<proje-id>.supabase.co
# Tarayıcıdan imzalı URL ile yükleme için (anon / publishable key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SADECE sunucuda kullanılır, asla paylaşmayın (service_role veya sb_secret_ key)
SUPABASE_SERVICE_ROLE_KEY=
